NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://aei:aei@localhost:5432/aei
LOG_LEVEL=info
CORS_ORIGIN=*

# --- AI Core ---
AI_CORE_URL=http://localhost:8000
AI_CORE_TIMEOUT_MS=8000
AI_CORE_MAX_RETRIES=2

# --- Environment scope (change these to point at a different deployment) ---
ENVIRONMENT_SCOPE=niat-kkh-campus
ENVIRONMENT_LOCATION_NAME=South Gate
ENVIRONMENT_LATITUDE=17.385
ENVIRONMENT_LONGITUDE=78.4867

# --- External providers ---
# Open-Meteo requires no API key.
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
TRAFFIC_API_URL=https://api.tomtom.com/traffic/services/4/flowSegmentData/absolute/10/json
# Optional: without a key the traffic provider uses a deterministic fallback
# so the pipeline still runs end to end. Get one at developer.tomtom.com.
TOMTOM_API_KEY=
EXTERNAL_API_TIMEOUT_MS=6000

# --- Pipeline ---
# Set to 0 to disable background polling (manual refresh still works).
ENVIRONMENT_POLL_INTERVAL_MS=60000

# --- Organization Understanding Engine ---
# Nominatim requires no key but requires a descriptive User-Agent — set this
# to your app name and a real contact before any non-local/demo usage.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=agentic-environment-intelligence/0.1 (hackathon-demo; no-contact-configured)
NOMINATIM_TIMEOUT_MS=8000
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_QUERY_TIMEOUT_S=20
OVERPASS_TIMEOUT_MS=25000
ORG_MAX_ENTITIES=200
ORG_CACHE_DIR=.cache/organizations
# 7 days, in milliseconds — organization infrastructure rarely changes.
ORG_CACHE_TTL_MS=604800000
